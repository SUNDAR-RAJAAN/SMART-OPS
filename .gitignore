# 4. Go Backend & Executables
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
bin/
server.exe
main.exe

# 5. Local Databases & SQLite Locks
*.db
*.db-journal
*.db-wal
*.db-shm
smartops.db
smartops.db-wal
smartops.db-shm

# 6. Uploaded Files Storage
uploads/*
